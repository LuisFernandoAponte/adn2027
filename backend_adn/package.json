{
  "name": "backend_adn",
  "version": "1.0.0",
  "description": "API ADN Motors con Prisma y PostgreSQL",
  "type": "module",
  "main": "src/app.js",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "db:apply:sql": "node scripts/deploy_supabase_sql.js",
    "db:setup:supabase": "prisma db push && node scripts/deploy_supabase_sql.js && node prisma/seed.js",
    "postinstall": "prisma generate"
  },
