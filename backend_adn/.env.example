# =============================================================================
# ADN MOTORS — Configuración de Entorno
# =============================================================================
# Copia este archivo como .env y completa cada variable.
# NUNCA subas .env a Git. Este .env.example es la guía.

# ─────────────────────────────────────────────
# 1. SERVIDOR
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# 2. BASE DE DATOS (PostgreSQL)
# ─────────────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://postgres:tu_contraseña@localhost:5432/adn_motors"

# ─────────────────────────────────────────────
# 3. JWT (JSON Web Tokens)
# ─────────────────────────────────────────────
# JWT_SECRET: Cámbialo por una clave segura. En terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia_esto_por_una_clave_aleatoria_segura"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# 4. EMAIL (Gmail con App Password)
# ─────────────────────────────────────────────
# PASO A PASO para obtener EMAIL_APP_PASSWORD:
#
#   1. Ve a https://myaccount.google.com/security
#   2. Activa "Verificación en dos pasos" si no la tienes
#   3. Ve a "Contraseñas de aplicaciones":
#      https://myaccount.google.com/apppasswords
#   4. Selecciona "Correo" y "Windows Computer" como dispositivo
#   5. Google te generará una contraseña de 16 caracteres (ej: "abcd efgh ijkl mnop")
#   6. Copia esa contraseña (sin espacios) como EMAIL_APP_PASSWORD
#   7. EMAIL_USER es tu dirección de Gmail completa
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@gmail.com
EMAIL_APP_PASSWORD=abcd efgh ijkl mnop   ← reemplazar con la App Password de 16 caracteres

# ─────────────────────────────────────────────
# 5. GOOGLE OAUTH (Login con Google)
# ─────────────────────────────────────────────
# PASO A PASO para obtener GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET:
#
#   1. Ve a https://console.cloud.google.com/
#   2. Crea un proyecto nuevo o selecciona uno existente
#   3. Ve a "APIs y Servicios" → "Pantalla de consentimiento de OAuth"
#   4. Elige "Externo" (External), completa:
#      - Nombre: ADN Motors
#      - Email de soporte: tu_correo@gmail.com
#      - Dominios autorizados: localhost (dev), tudominio.com (prod)
#   5. En "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth"
#   6. Tipo: "Aplicación web"
#   7. Orígenes JS autorizados:
#      - http://localhost:5173
#      - http://localhost:3000
#   8. URIs de redirección autorizados:
#      - http://localhost:3000/api/auth/google/callback
#   9. Google te dará:
#      - GOOGLE_CLIENT_ID (termina en .apps.googleusercontent.com)
#      - GOOGLE_CLIENT_SECRET (mantenlo secreto)
#
GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# 6. CORS (orígenes permitidos)
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────
# 7. RATE LIMITING (seguridad anti-fuerza bruta)
# ─────────────────────────────────────────────
# General: máximo 200 requests cada 15 minutos
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Auth: máximo 10 intentos de login por minuto por IP
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# ─────────────────────────────────────────────
# 8. CLOUDINARY (Almacenamiento de Fotos e Inspecciones)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# ─────────────────────────────────────────────
# 9. BREVO / RESEND (Servicio de Email Transaccional en Producción)
# ─────────────────────────────────────────────
BREVO_API_KEY=xkeysib-tu_clave_brevo_aqui
# RESEND_API_KEY=re_tu_clave_resend_aqui

# ─────────────────────────────────────────────
# 10. PRODUCCIÓN (cuando despliegues)
# ─────────────────────────────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://tudominio.com
# BACKEND_URL=https://api.tudominio.com
# DATABASE_URL=postgresql://... (tu DB de producción)
# DIRECT_URL=postgresql://... (conexión directa sin pooler)
# JWT_SECRET=<clave_ultra_segura_generada_con_crypto>
# EMAIL_USER=notificaciones@tudominio.com
# CORS_ORIGINS=https://tudominio.com
# Además: configura HTTPS con certificado SSL (Let's Encrypt, Cloudflare, etc.)

